                    "pm.environment.set('current_date', new Date().toISOString().split('T')[0]);",
                    "",
                    "// Generate random values for testing",
                    "pm.environment.set('random_suffix', Math.random().toString(36).substring(7));",
                    "",
                    "// Set security headers if not already set",
                    "if (!pm.environment.get('csrf_token')) {",
