                "type": "text/javascript",
                "exec": [
                    "// Enhanced response validation",
                    "pm.test('Status code is successful or expected error', function () {",
                    "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 401, 403, 404, 429]);",
                    "});",
                    "",
                    "pm.test('Response time is reasonable', function () {",
                    "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                    "});",
                    "",
                    "pm.test('Response has JSON content-type', function () {",
                    "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                    "});",
                    "",
                    "// Validate success response format",
                    "if (pm.response.code === 200) {",
                    "    pm.test('Success response has correct format', function () {",
                    "        const response = pm.response.json();",
                    "        pm.expect(response).to.have.property('success', true);",
                    "        pm.expect(response).to.have.property('auditId');",
                    "        pm.expect(response).to.have.property('timestamp');",
                    "        pm.expect(response).to.have.property('securityContext');",
                    "        ",
                    "        if (response.securityContext) {",
                    "            pm.expect(response.securityContext).to.have.property('riskScore');",
                    "            pm.expect(response.securityContext).to.have.property('encryptionLevel');",
                    "        }",
                    "    });",
                    "}",
                    "",
                    "// Validate error response format",
                    "if (pm.response.code >= 400) {",
                    "    pm.test('Error response has correct format', function () {",
                    "        const response = pm.response.json();",
                    "        pm.expect(response).to.have.property('error');",
                    "        pm.expect(response.error).to.have.property('message');",
                    "        pm.expect(response.error).to.have.property('code');",
                    "        pm.expect(response.error).to.have.property('requestId');",
                    "        pm.expect(response.error).to.have.property('timestamp');",
                    "    });",
                    "}",
                    "",
                    "// Extract API key from generation response for future use",
                    "if (pm.request.url.path.includes('generate') && pm.response.code === 200) {",
                    "    try {",
                    "        const response = pm.response.json();",
                    "        if (response.data && response.data.apiKey) {",
                    "            pm.environment.set('last_generated_api_key', response.data.apiKey);",
                    "            pm.environment.set('last_generated_api_key_id', response.data.apiKeyId);",
                    "            console.log('Generated API Key and ID saved to environment');",
                    "        }",
                    "        if (response.auditId) {",
                    "            pm.environment.set('last_audit_id', response.auditId);",
                    "        }",
                    "    } catch (e) {",
                    "        console.log('Could not parse response for API key extraction');",
                    "    }",
                    "}",
                    "",
                    "// Extract API key IDs from list responses",
                    "if (pm.request.url.path.includes('api-keys') && pm.response.code === 200) {",
                    "    try {",
                    "        const response = pm.response.json();",
                    "        if (response.data && Array.isArray(response.data) && response.data.length > 0) {",
                    "            pm.environment.set('first_api_key_id', response.data[0]._id);",
                    "            console.log('First API Key ID saved to environment');",
                    "        }",
                    "    } catch (e) {",
                    "        console.log('Could not parse response for API key ID extraction');",
                    "    }",
                    "}",
                    "",
                    "// Log security context for monitoring",
                    "if (pm.response.code === 200) {",
                    "    try {",
                    "        const response = pm.response.json();",
                    "        if (response.securityContext) {",
                    "            console.log('Security Context:', JSON.stringify(response.securityContext, null, 2));",
                    "        }",
                    "    } catch (e) {",
                    "        // Ignore parsing errors",
                    "    }",
                    "}"
                ]
            }
        }
