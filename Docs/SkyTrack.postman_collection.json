{
    "info": {
        "name": "SkyTrack Backend API",
        "description": "Comprehensive API collection for SkyTrack flight school management system",
        "version": "1.0.0",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [{
            "key": "token",
            "value": "{{jwt_token}}",
            "type": "string"
        }]
    },
    "variable": [{
            "key": "base_url",
            "value": "https://api.skytrack.com",
            "type": "string"
        },
        {
            "key": "api_key",
            "value": "your-api-key",
            "type": "string"
        },
        {
            "key": "csrf_token",
            "value": "csrf-token-here",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "jwt-token-here",
            "type": "string"
        }
    ],
    "item": [{
            "name": "Authentication",
            "item": [{
                    "name": "Get CSRF Token",
                    "request": {
                        "method": "GET",
                        "header": [{
                            "key": "X-API-Key",
                            "value": "{{api_key}}",
                            "type": "text"
                        }],
                        "url": {
                            "raw": "{{base_url}}/api/auth/csrf-token",
                            "host": ["{{base_url}}"],
                            "path": ["api", "auth", "csrf-token"]
                        },
                        "description": "Generate and retrieve a CSRF token for secure form submissions"
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "exec": [
                                "pm.test('Status code is 200', function () {",
                                "    pm.response.to.have.status(200);",
                                "});",
                                "",
                                "pm.test('Response has CSRF token', function () {",
                                "    const jsonData = pm.response.json();",
                                "    pm.expect(jsonData.data.token).to.be.a('string');",
                                "    pm.collectionVariables.set('csrf_token', jsonData.data.token);",
                                "});"
                            ]
                        }
                    }]
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [{
                            "key": "Content-Type",
                            "value": "application/json",
                            "type": "text"
                        }],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"your-password\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/auth/login",
                            "host": ["{{base_url}}"],
                            "path": ["api", "auth", "login"]
                        },
                        "description": "Authenticate user with email and password"
                    },
                    "event": [{
                        "listen": "test",
                        "script": {
                            "exec": [
                                "pm.test('Status code is 200', function () {",
                                "    pm.response.to.have.status(200);",
                                "});",
                                "",
                                "pm.test('Response has JWT token', function () {",
                                "    const jsonData = pm.response.json();",
                                "    pm.expect(jsonData.data.token).to.be.a('string');",
                                "    pm.collectionVariables.set('jwt_token', jsonData.data.token);",
                                "    pm.collectionVariables.set('csrf_token', jsonData.data.csrfToken);",
                                "});"
                            ]
