        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [{
            "key": "baseUrl",
            "value": "https://api.backend.com",
            "type": "string"
        },
        {
            "key": "apiKey",
            "value": "your-api-key-here",
            "type": "string"
        },
        {
            "key": "jwtToken",
            "value": "your-jwt-token-here",
            "type": "string"
        },
        {
            "key": "csrfToken",
            "value": "your-csrf-token-here",
            "type": "string"
        },
        {
            "key": "schoolId",
            "value": "64def789abc123",
            "type": "string"
        },
        {
            "key": "billingRecordId",
            "value": "64abc123def456",
            "type": "string"
        },
        {
            "key": "currentAuditId",
            "value": "",
            "type": "string"
        }
    ],
    "auth": {
        "type": "bearer",
        "bearer": [{
            "key": "token",
            "value": "{{jwtToken}}",
            "type": "string"
        }]
    },
    "event": [{
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Auto-generate timestamp for requests",
                    "pm.globals.set('timestamp', new Date().toISOString());",
                    "",
                    "// Log request details",
                    "console.log('🚀 Request:', pm.request.method, pm.request.url.toString());",
                    "console.log('📋 Headers:', JSON.stringify(pm.request.headers.toObject()));",
                    "",
                    "// Validate required variables",
                    "const requiredVars = ['baseUrl', 'apiKey', 'jwtToken'];",
                    "requiredVars.forEach(varName => {",
                    "    if (!pm.collectionVariables.get(varName) || pm.collectionVariables.get(varName) === `your-${varName.toLowerCase().replace('jwt', 'jwt-')}-here`) {",
                    "        console.warn(`⚠️ Please set the ${varName} collection variable`);",
                    "    }",
                    "});"
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Extract and store audit ID from response",
                    "if (pm.response.json() && pm.response.json().auditId) {",
                    "    pm.collectionVariables.set('currentAuditId', pm.response.json().auditId);",
                    "    console.log('📝 Audit ID:', pm.response.json().auditId);",
                    "}",
                    "",
                    "// Log response summary",
                    "console.log('📊 Response:', pm.response.status, pm.response.statusText);",
                    "console.log('⏱️ Response Time:', pm.response.responseTime + 'ms');",
                    "",
                    "// Basic response validation",
                    "pm.test('Response time is acceptable', function () {",
                    "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                    "});",
                    "",
                    "pm.test('Response has proper headers', function () {",
                    "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                    "});"
                ]
            }
        }
    ],
