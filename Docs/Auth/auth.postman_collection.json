    "event": [{
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Set current timestamp for dynamic values",
                    "pm.environment.set('current_timestamp', new Date().toISOString());",
                    "",
                    "// Generate random values for testing",
                    "pm.environment.set('random_suffix', Math.random().toString(36).substring(7));",
                    "",
                    "// Set default values if not already set",
                    "if (!pm.environment.get('csrf_token')) {",
                    "    pm.environment.set('csrf_token', 'your_csrf_token_here');",
                    "}",
                    "",
                    "if (!pm.environment.get('api_key')) {",
                    "    pm.environment.set('api_key', 'your_api_key_here');",
                    "}"
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Enhanced response validation",
                    "pm.test('Status code is successful or expected error', function () {",
                    "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 401, 403, 404, 428, 429]);",
                    "});",
                    "",
                    "pm.test('Response time is reasonable', function () {",
                    "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                    "});",
                    "",
                    "pm.test('Response has JSON content-type', function () {",
                    "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                    "});",
                    "",
                    "// Validate success response format",
                    "if (pm.response.code === 200 || pm.response.code === 201) {",
                    "    pm.test('Success response has correct format', function () {",
                    "        const response = pm.response.json();",
                    "        if (response.success !== undefined) {",
                    "            pm.expect(response).to.have.property('success', true);",
                    "        }",
                    "        if (response.auditId) {",
                    "            pm.expect(response).to.have.property('auditId');",
                    "        }",
                    "        if (response.timestamp) {",
                    "            pm.expect(response).to.have.property('timestamp');",
                    "        }",
                    "    });",
                    "}",
                    "",
                    "// Validate error response format",
                    "if (pm.response.code >= 400) {",
                    "    pm.test('Error response has correct format', function () {",
                    "        const response = pm.response.json();",
                    "        pm.expect(response).to.have.property('error');",
                    "        pm.expect(response.error).to.have.property('message');",
                    "        pm.expect(response.error).to.have.property('code');",
                    "        if (response.error.requestId) {",
                    "            pm.expect(response.error).to.have.property('requestId');",
                    "        }",
                    "        if (response.error.timestamp) {",
                    "            pm.expect(response.error).to.have.property('timestamp');",
                    "        }",
                    "    });",
                    "}",
                    "",
                    "// Extract tokens from responses",
                    "if (pm.response.code === 200 || pm.response.code === 201) {",
                    "    try {",
                    "        const response = pm.response.json();",
                    "        ",
                    "        // Extract JWT token",
                    "        if (response.data && response.data.token) {",
                    "            pm.environment.set('jwt_token', response.data.token);",
                    "            console.log('JWT token saved to environment');",
                    "        } else if (response.token) {",
                    "            pm.environment.set('jwt_token', response.token);",
                    "            console.log('JWT token saved to environment');",
                    "        }",
                    "        ",
                    "        // Extract CSRF token",
                    "        if (response.data && response.data.csrfToken) {",
                    "            pm.environment.set('csrf_token', response.data.csrfToken);",
                    "            console.log('CSRF token saved to environment');",
                    "        } else if (response.csrfToken) {",
                    "            pm.environment.set('csrf_token', response.csrfToken);",
                    "            console.log('CSRF token saved to environment');",
                    "        } else if (response.data && response.data.token && pm.request.url.path.includes('csrf-token')) {",
                    "            pm.environment.set('csrf_token', response.data.token);",
                    "            console.log('CSRF token saved to environment');",
                    "        }",
                    "        ",
                    "        // Save audit ID for tracking",
                    "        if (response.auditId) {",
                    "            pm.environment.set('last_audit_id', response.auditId);",
                    "        }",
                    "    } catch (e) {",
                    "        console.log('Could not parse response for token extraction');",
                    "    }",
                    "}",
                    "",
                    "// Log security context for monitoring",
                    "if (pm.response.code === 200 || pm.response.code === 201) {",
                    "    try {",
                    "        const response = pm.response.json();",
                    "        if (response.securityContext) {",
                    "            console.log('Security Context:', JSON.stringify(response.securityContext, null, 2));",
                    "        }",
                    "    } catch (e) {",
                    "        // Ignore parsing errors",
                    "    }",
                    "}"
                ]
            }
        }
    ],
