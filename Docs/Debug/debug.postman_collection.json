{
    "info": {
        "name": "Debug API",
        "description": "Debug and testing endpoints for the API. These endpoints are designed for development, testing, and troubleshooting purposes.",
        "version": "1.0.0",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "apikey",
        "apikey": [{
                "key": "key",
                "value": "X-API-Key",
                "type": "string"
            },
            {
                "key": "value",
                "value": "{{api_key}}",
                "type": "string"
            }
        ]
    },
    "variable": [{
            "key": "base_url",
            "value": "http://localhost:3000/api/debug",
            "type": "string",
            "description": "Base URL for debug endpoints"
        },
        {
            "key": "api_key",
            "value": "your-api-key-here",
            "type": "string",
            "description": "Your API key for authentication"
        },
        {
            "key": "jwt_token",
            "value": "your-jwt-token-here",
            "type": "string",
            "description": "Your JWT token for authenticated endpoints"
        },
        {
            "key": "csrf_token",
            "value": "your-csrf-token-here",
            "type": "string",
            "description": "CSRF token for POST requests"
        },
        {
            "key": "test_email",
            "value": "test@example.com",
            "type": "string",
            "description": "Email address for testing email functionality"
        }
    ],
