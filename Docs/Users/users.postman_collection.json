    "event": [{
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Set current timestamp for dynamic values",
                    "pm.environment.set('current_timestamp', new Date().toISOString());",
                    "",
                    "// Generate random values for testing",
                    "pm.environment.set('random_suffix', Math.random().toString(36).substring(7));",
                    "",
                    "// Auto-inject CSRF token for PUT requests",
                    "if (pm.request.method === 'PUT' && !pm.request.headers.has('X-CSRF-Token')) {",
                    "    pm.request.headers.add({",
                    "        key: 'X-CSRF-Token',",
                    "        value: pm.environment.get('csrf_token') || 'your_csrf_token_here'",
                    "    });",
                    "}",
                    "",
                    "// Auto-inject API key if missing",
                    "if (!pm.request.headers.has('X-API-Key')) {",
                    "    pm.request.headers.add({",
                    "        key: 'X-API-Key',",
                    "        value: pm.environment.get('api_key') || 'your_api_key_here'",
                    "    });",
                    "}",
                    "",
                    "// Set default values if not already set",
                    "if (!pm.environment.get('user_id')) {",
                    "    pm.environment.set('user_id', '674a1b2c3d4e5f6789012345');",
                    "}",
                    "",
                    "if (!pm.environment.get('current_user_id')) {",
                    "    pm.environment.set('current_user_id', pm.environment.get('user_id'));",
                    "}",
                    "",
                    "// Generate test data",
                    "pm.environment.set('updated_email', 'updated_' + pm.environment.get('random_suffix') + '@example.com');",
                    "pm.environment.set('new_email', 'new_' + pm.environment.get('random_suffix') + '@example.com');"
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "// Enhanced response validation",
                    "pm.test('Status code is successful or expected error', function () {",
                    "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 403, 404, 409, 429, 500]);",
                    "});",
                    "",
                    "pm.test('Response time is reasonable', function () {",
                    "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                    "});",
                    "",
                    "pm.test('Response has JSON content-type', function () {",
                    "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                    "});",
                    "",
                    "// Validate success response format",
                    "if (pm.response.code === 200) {",
                    "    pm.test('Success response has correct format', function () {",
                    "        const response = pm.response.json();",
                    "        pm.expect(response).to.have.property('success', true);",
                    "        pm.expect(response).to.have.property('message');",
                    "        pm.expect(response).to.have.property('data');",
                    "        pm.expect(response.data).to.have.property('user');",
                    "        pm.expect(response).to.have.property('auditId');",
                    "        pm.expect(response).to.have.property('timestamp');",
                    "    });",
                    "    ",
                    "    pm.test('User object has required fields', function () {",
                    "        const response = pm.response.json();",
                    "        const user = response.data.user;",
                    "        pm.expect(user).to.have.property('_id');",
                    "        pm.expect(user).to.have.property('email');",
                    "        pm.expect(user).to.have.property('first_name');",
                    "        pm.expect(user).to.have.property('last_name');",
                    "        pm.expect(user).to.have.property('role');",
                    "        pm.expect(user).to.have.property('isActive');",
                    "        pm.expect(user).to.have.property('emailVerified');",
                    "        pm.expect(user).to.have.property('createdAt');",
                    "        pm.expect(user).to.have.property('updatedAt');",
                    "    });",
                    "    ",
                    "    pm.test('User role is valid', function () {",
                    "        const response = pm.response.json();",
                    "        const validRoles = ['sys_admin', 'school_admin', 'instructor', 'student'];",
                    "        pm.expect(validRoles).to.include(response.data.user.role);",
                    "    });",
                    "}",
                    "",
                    "// Validate error response format",
                    "if (pm.response.code >= 400) {",
                    "    pm.test('Error response has correct format', function () {",
                    "        const response = pm.response.json();",
                    "        pm.expect(response).to.have.property('error');",
                    "        pm.expect(response.error).to.have.property('message');",
                    "        pm.expect(response.error).to.have.property('code');",
                    "        pm.expect(response.error).to.have.property('requestId');",
                    "        pm.expect(response.error).to.have.property('timestamp');",
                    "    });",
                    "    ",
                    "    pm.test('Error code is valid', function () {",
                    "        const response = pm.response.json();",
                    "        const validErrorCodes = [",
                    "            'INVALID_USER_ID', 'INVALID_EMAIL_FORMAT', 'INVALID_ROLE', 'INVALID_SCHOOL_ID',",
                    "            'AUTHENTICATION_FAILED', 'INSUFFICIENT_PERMISSIONS', 'ROLE_CHANGE_FORBIDDEN',",
                    "            'USER_NOT_FOUND', 'EMAIL_ALREADY_EXISTS', 'UPDATE_FAILED', 'RATE_LIMIT_EXCEEDED'",
                    "        ];",
                    "        pm.expect(validErrorCodes).to.include(response.error.code);",
                    "    });",
                    "}",
                    "",
                    "// Extract and save user data for subsequent requests",
                    "if (pm.response.code === 200) {",
                    "    try {",
                    "        const response = pm.response.json();",
                    "        ",
                    "        // Save user data for subsequent requests",
                    "        if (response.data && response.data.user) {",
                    "            pm.environment.set('last_user_id', response.data.user._id);",
                    "            pm.environment.set('last_user_email', response.data.user.email);",
                    "            pm.environment.set('last_user_role', response.data.user.role);",
                    "            pm.environment.set('last_user_school_id', response.data.user.school_id || '');",
                    "            console.log('User data saved:', {",
                    "                id: response.data.user._id,",
                    "                email: response.data.user.email,",
                    "                role: response.data.user.role",
                    "            });",
                    "        }",
                    "        ",
                    "        // Save audit ID for tracking",
                    "        if (response.auditId) {",
                    "            pm.environment.set('last_audit_id', response.auditId);",
                    "        }",
                    "    } catch (e) {",
                    "        console.log('Could not parse response for data extraction');",
                    "    }",
                    "}",
                    "",
                    "// Security and access control tests",
                    "if (pm.response.code === 403) {",
                    "    pm.test('Access denied error is properly handled', function () {",
                    "        const response = pm.response.json();",
                    "        pm.expect(response.error.code).to.be.oneOf([",
                    "            'INSUFFICIENT_PERMISSIONS', 'ROLE_CHANGE_FORBIDDEN'",
                    "        ]);",
                    "    });",
                    "}",
                    "",
                    "// Rate limiting tests",
                    "if (pm.response.code === 429) {",
                    "    pm.test('Rate limiting response includes retry information', function () {",
                    "        const response = pm.response.json();",
                    "        pm.expect(response.error.code).to.equal('RATE_LIMIT_EXCEEDED');",
                    "        // Check if retryAfter is present (optional field)",
                    "        if (response.error.retryAfter) {",
                    "            pm.expect(response.error.retryAfter).to.be.a('number');",
                    "        }",
                    "    });",
                    "}",
                    "",
                    "// Validation error tests",
                    "if (pm.response.code === 400) {",
                    "    pm.test('Validation error has appropriate code', function () {",
                    "        const response = pm.response.json();",
                    "        pm.expect(response.error.code).to.be.oneOf([",
                    "            'INVALID_USER_ID', 'INVALID_EMAIL_FORMAT', 'INVALID_ROLE', 'INVALID_SCHOOL_ID'",
                    "        ]);",
                    "    });",
                    "}",
                    "",
                    "// Conflict error tests",
                    "if (pm.response.code === 409) {",
                    "    pm.test('Conflict error is for email uniqueness', function () {",
                    "        const response = pm.response.json();",
                    "        pm.expect(response.error.code).to.equal('EMAIL_ALREADY_EXISTS');",
                    "    });",
                    "}",
                    "",
                    "// Log security context for monitoring",
                    "if (pm.response.code === 200) {",
                    "    try {",
                    "        const response = pm.response.json();",
                    "        if (response.securityContext) {",
                    "            console.log('Security Context:', JSON.stringify(response.securityContext, null, 2));",
                    "        }",
                    "    } catch (e) {",
                    "        // Ignore parsing errors",
                    "    }",
                    "}",
                    "",
                    "// Performance monitoring",
                    "pm.test('Response time is within acceptable limits', function () {",
                    "    if (pm.request.method === 'GET') {",
